{
  "uid": "tptruck-map-tracking",
  "title": "TP-Truck | Map & GPS Tracking",
  "tags": ["tp-truck", "map", "gps"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Map API p95 Latency (s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"truck-fleet-app\",uri=~\"/api/v1/map/.*|/api/v1/routes/.*/position\"}[5m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "WebSocket Active Connections",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "map_websocket_connections_active{job=\"truck-fleet-app\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "GPS Ingest Rate (positions/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"truck-fleet-app\",uri=~\"/api/v1/routes/.*/position\",method=\"POST\"}[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "GPS Ingest 5xx Error Rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"truck-fleet-app\",uri=~\"/api/v1/routes/.*/position\",status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=\"truck-fleet-app\",uri=~\"/api/v1/routes/.*/position\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "WebSocket Disconnect Rate",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "rate(map_websocket_disconnections_total{job=\"truck-fleet-app\"}[5m])",
          "refId": "A"
        }
      ]
    }
  ]
}

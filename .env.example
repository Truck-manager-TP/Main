# Copy to .env and adjust. NEVER commit a real .env with production secrets.
APP_ENV=dev
APP_VERSION=1.0.0

# Database
DB_NAME=tptruck
DB_USER=tptruck
DB_PASSWORD=change-me-in-non-dev

# Observability -> ITSM bridge (Grafana alerts)
SERVICENOW_WEBHOOK_URL=https://dev00000.service-now.com/api/x_tptruck/grafana_ingest
JIRA_BRIDGE_URL=http://jira-bridge:8090/webhooks/grafana

# Jira (Grafana alerts + pipeline failures — project KAN)
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_EMAIL=devops@yourcompany.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=KAN
JIRA_ISSUE_TYPE=Bug

# ServiceNow (change + incident automation from Jenkins)
SERVICENOW_INSTANCE=dev00000.service-now.com
SERVICENOW_USER=jenkins.integration
SERVICENOW_PASSWORD=

# SonarQube analysis token (CI + exporter)
SONAR_TOKEN=

# Admin map dashboard (change in non-dev)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-non-dev
